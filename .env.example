COMPOSE_PROJECT_NAME=sanserif

# Database (local defaults; override in production)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# S3 / MinIO (local defaults; override in production)
S3_ACCESS_KEY_ID=root
S3_ACCESS_SECRET=rootroot
S3_BUCKET_NAME=strapi-media
S3_ENDPOINT=http://127.0.0.1:9000
S3_BASE_URL=http://localhost:9000/strapi-media
MEDIA_DOMAIN=localhost:9000

# Mail / Mailpit (local development only; production uses Cloudflare Email Service)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_EMAIL=Sanserif <sanserif@localhost>
