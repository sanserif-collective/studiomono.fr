---
import Container from 'components/Container.astro';
import ProjectCard from 'components/ProjectCard.astro';
import Sprite from 'components/Sprite.astro';
import Text from 'components/Text.astro';
import type { NotFound } from 'types/routes/not-found';
import type { Shared } from 'types/shared';
import type { Strapi } from 'types/strapi';

type Props = {
  content: NotFound.Components;
  projects: Strapi.Attributes<Shared.Project.Components>[];
};

const {
  content,
  projects: [project1, project2, project3, project4],
}: Props = Astro.props;
---

<Container fullscreen={true}>
  <header
    class:list={[
      'col-start-2 col-end-5 row-start-3 row-end-7 flex flex-col justify-end',
      'portrait:col-end-12 portrait:row-start-3 portrait:justify-start',
    ]}
  >
    <h1 class="sr-only">{content.title}</h1>
    <Text size="xl" as="h2" class="max-w-sm">
      {content.subtitle}
    </Text>
    <div class="mt-4 flex items-center">
      <p>{content.text}</p>
      <Sprite id="arrow" class="ml-2 h-4 w-4" />
    </div>
  </header>
  <article
    class:list={[
      'col-start-2 col-end-4 row-start-8 row-end-12 flex items-end',
      'portrait:col-end-7 portrait:row-start-7 portrait:row-end-10 portrait:items-start',
    ]}
  >
    <ProjectCard
      width={200}
      height={300}
      loading="eager"
      class="w-[22vh]"
      project={project1.attributes}
    />
  </article>
  <article
    class:list={[
      'col-start-5 col-end-7 row-start-8 row-end-12 flex items-center',
      'portrait:col-start-8 portrait:col-end-12 portrait:items-end',
      'portrait:row-start-9 portrait:justify-end portrait:pb-custom-space',
    ]}
  >
    <ProjectCard
      width={140}
      height={188}
      loading="eager"
      class="w-[18vh]"
      project={project2.attributes}
    />
  </article>
  <article
    class:list={[
      'col-start-9 col-end-12 row-start-4 flex items-center justify-end',
      'row-end-8 portrait:hidden',
    ]}
  >
    <ProjectCard
      width={440}
      height={410}
      loading="eager"
      class="w-[40vh]"
      project={project3.attributes}
    />
  </article>
  <article class="col-start-6 col-end-8 row-start-2 row-end-6 flex portrait:hidden">
    <ProjectCard
      width={300}
      height={400}
      loading="eager"
      class="w-[30vh]"
      project={project4.attributes}
    />
  </article>
  <div class="-z-10 col-span-full row-span-full overflow-hidden">
    <Sprite id="404" class="h-full w-full scale-110 fill-black/5" />
  </div>
</Container>
