---
import Container from 'components/Container.astro';
import Text from 'components/Text.astro';
import { app } from 'src/app';
import type { Contact } from 'types/routes/contact';

type Props = {
  content: Contact.Header;
};

const { content }: Props = Astro.props;
---

<Container as="section" class="sm:children:col-start-2 sm:children:col-end-12" fullscreen={true}>
  <header
    class:list={[
      'col-start-4 col-end-10 row-start-3 row-end-5 flex flex-col',
      'justify-center space-y-4 text-center',
    ]}
  >
    <h1>{content.title}</h1>
    <Text as="h2" size="2xl">
      {content.subtitle}
    </Text>
    <p class="mx-auto max-w-lg">{content.text}</p>
  </header>
  <footer
    class:list={[
      'col-start-4 col-end-10 row-start-6 grid place-content-center',
      'relative row-end-12 text-center',
    ]}
  >
    <svg
      viewBox="0 0 1 1"
      class:list={[
        'absolute left-1/2 top-1/2 rounded-full border border-black/10',
        'h-full -translate-x-1/2 -translate-y-1/2 sm:h-auto sm:w-full',
      ]}
    ></svg>
    <a href={`tel:${app.global?.informations.phone}`}>{app.global?.informations.phone}</a>
    <a href={`mailto:${app.global?.informations.email}`}>{app.global?.informations.email}</a>
    <small>{app.global?.informations.location}</small>
  </footer>
</Container>
