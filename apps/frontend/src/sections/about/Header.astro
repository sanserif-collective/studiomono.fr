---
import Container from 'components/Container.astro';
import Image from 'components/Image.astro';
import Sprite from 'components/Sprite.astro';
import Text from 'components/Text.astro';
import type { About } from 'types/routes/about';

type Props = {
  content: About.Header;
};

const { content }: Props = Astro.props;
---

<Container fullscreen={true} as="header">
  <div class="col-start-2 col-end-12 row-start-2 row-end-12 flex items-end portrait:row-end-13">
    <sanserif-skew>
      <Text size="3xl" class="max-w-[3em]">
        {content.title}
      </Text>
    </sanserif-skew>
  </div>
  <div class="col-start-2 col-end-6 row-start-4 portrait:col-end-12">
    <Text class="max-w-lg">{content.text}</Text>
  </div>
  <div
    class:list={[
      'col-start-6 col-end-12 row-start-4 row-end-9 flex justify-end',
      'portrait:col-start-2 portrait:row-start-6',
    ]}
  >
    <sanserif-skew>
      <Image
        src={content.image.data.attributes.url}
        alt={content.image.data.attributes.alternativeText}
        width={680}
        height={420}
        class="w-[68vmin] xl:w-[50vmin] md:w-[60vmin]"
      />
    </sanserif-skew>
  </div>
  <div
    class:list={[
      'col-start-8 col-end-12 row-start-10 flex items-center justify-end',
      'portrait:row-start-12 portrait:items-end portrait:text-right',
    ]}
  >
    <Text as="h2" size="lg">
      {content.subtitle}
    </Text>
    <Sprite id="arrow" class="ml-4 h-6 w-6 text-black portrait:mb-1 portrait:rotate-90" />
  </div>
</Container>
