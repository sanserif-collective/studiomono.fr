---
import Container from 'components/Container.astro';
import Image from 'components/Image.astro';
import Text from 'components/Text.astro';
import type { Shared } from 'types/shared';

type Props = {
  title: string;
  subtitle: string;
  members: Shared.Member[];
};

const { title, subtitle, members }: Props = Astro.props;
---

<Container class="portrait:mt-40">
  <header class="row-span-full grid w-[50vw] place-content-center portrait:col-start-2 portrait:col-end-12 portrait:row-auto portrait:w-auto portrait:place-content-start">
    {subtitle}
    <sanserif-skew>
      <Text size="3xl" as="h2" class="mt-8 max-w-[3em]">
        {title}
      </Text>
    </sanserif-skew>
  </header>

  <sanserif-team class="row-start-5 row-end-12 flex flex-col justify-between portrait:col-start-2 portrait:col-end-12 portrait:row-auto portrait:mt-40">
    <div class="portrait:hidden">
      <sanserif-skew data-member-names class="inline-grid">
        {members.map(({ attributes }) => (
          <div class="relative col-start-1 row-start-1 flex" data-member-name>
            <Text as="h3" size="2xl">
              {attributes.name}
            </Text>
            <Text as="h4" class="ml-8">
              ({attributes.role})
            </Text>
          </div>
        ))}
      </sanserif-skew>
    </div>
    <div class="flex items-end space-x-8 portrait:flex-col portrait:items-center portrait:space-x-0 portrait:space-y-8">
      {members.map(({ attributes }) => (
        <sanserif-skew class="flex w-[25vh] justify-center overflow-hidden portrait:w-[50vmin]">
          <Image
            data-member-image
            class="w-[20vh] portrait:!w-full"
            alt={attributes.name}
            src={attributes.image.data.attributes.url}
            height={290}
            width={210}
          />
        </sanserif-skew>
      ))}
    </div>
  </sanserif-team>
</Container>
