---
import Text from 'components/Text.astro';
import { app } from 'src/app';
import { route } from 'utilities/route';
import MarqueeItem from './MarqueeItem.astro';
---

<sanserif-menu
  class="fixed inset-0 grid place-content-center bg-black text-gray"
  style="display: none"
>
  <nav class="max-w-xl text-center">
    {app.global?.menu.links.map((link, index) => (
      <Text
        as="a"
        size="2xl"
        class:list={[
          'block overflow-hidden transition-opacity',
          route(link.route) !== Astro.url.pathname && 'opacity-25 hover:opacity-50',
        ]}
        href={route(link.route)}
        data-nav-link
      >
        <sanserif-marquee
          class="flex justify-center transition-opacity"
          direction={index % 2 === 0 ? -100 : 100}
          pauseonhover={true}
        >
          {Array.from({ length: 10 }, () => (
            <MarqueeItem>{link.name}</MarqueeItem>
          ))}
        </sanserif-marquee>
      </Text>
    ))}
  </nav>
  <div
    class:list={[
      'absolute inset-x-custom-space bottom-custom-space flex variation-normal',
      'items-end justify-between space-x-4 sm:flex-col sm:items-center sm:space-x-0',
    ]}
  >
    <div class="overflow-y-hidden">
      <small class="block" data-nav-small>
        {app.global?.informations.location}
      </small>
    </div>
    <div class="text-center">
      <div class="overflow-y-hidden">
        <a class="block" href={`mailto:${app.global?.informations.email}`} data-nav-small>
          {app.global?.informations.email}
        </a>
      </div>
      <div class="overflow-y-hidden">
        <a class="block" href={`tel:${app.global?.informations.phone}`} data-nav-small>
          {app.global?.informations.phone}
        </a>
      </div>
    </div>
    <div class="overflow-y-hidden">
      <small class="block" data-nav-small>
        {app.dictionary?.rights}
      </small>
    </div>
  </div>
</sanserif-menu>
