---
import type { AstroBuiltinAttributes } from 'astro';
import Image from 'components/Image.astro';
import type { Shared } from 'types/shared';
import { route } from 'utilities/route';
import MarqueeItem from './MarqueeItem.astro';
import Text from './Text.astro';

type Props = {
  width: number;
  height: number;
  loading?: 'eager' | 'lazy';
  project: Shared.Project.Components;
  'class:list'?: AstroBuiltinAttributes['class:list'];
  class?: string;
  [name: string]: unknown;
};

const {
  width,
  height,
  project,
  loading,
  'class:list': classList,
  class: className,
  ...rest
}: Props = Astro.props;
---

<div class:list={[classList, className]} {...rest}>
  <a href={route('projects', project.slug)}>
    <sanserif-skew
      class:list={[
        'group relative overflow-hidden transition-[clip-path]',
        'bg-gray [clip-path:inset(0)] hover:[clip-path:inset(0.75rem)]',
      ]}
    >
      <Text
        as="sanserif-marquee"
        size="xl"
        class:list={[
          'absolute top-1/2 z-10 flex h-full -translate-y-1/2 justify-center',
          'w-full items-center overflow-hidden variation-light',
        ]}
        playonhover
        delaybeforepause="1"
        role="heading"
        aria-level="3"
      >
        {Array.from({ length: 10 }, () => (
          <div class="flex-shrink-0 overflow-y-hidden">
            <MarqueeItem
              class:list={[
                'translate-y-full transform-gpu transition-transform',
                'group-hover:translate-y-0',
              ]}
            >
              {project.name}
            </MarqueeItem>
          </div>
        ))}
      </Text>
      <Image
        width={width}
        height={height}
        loading={loading}
        alt={project.name}
        src={project.cover.data.attributes.url}
        class:list={[
          'block transform-gpu transition-[opacity,transform]',
          'group-hover:scale-[102.5%] group-hover:opacity-70',
        ]}
      />
    </sanserif-skew>
  </a>
</div>
