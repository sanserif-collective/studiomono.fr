---
import Sprite from 'components/Sprite.astro';
import Text from 'components/Text.astro';

type Props = {
  url: string;
  caption: string;
};

const { url, caption }: Props = Astro.props;
---

<footer
  class:list={[
    'grid w-[calc(100vw_-_var(--custom-space))] place-content-center',
    'portrait:w-auto',
  ]}
>
  <sanserif-next-link class="mt-14 grid place-content-center portrait:py-[10vh]">
    <a href={url} class="block">
      <Text as="strong" size="3xl" class="relative">
        <div class="grid overflow-hidden text-center">
          {Array.from({ length: 2 }, () => (
            <sanserif-skew class="col-start-1 row-start-1 max-w-[6em]" data-split>
              <slot />
            </sanserif-skew>
          ))}
        </div>
      </Text>
      <small
        class:list={[
          'mt-8 flex transition-all duration-500 ease-in-out',
          'items-center justify-center',
        ]}
      >
        {caption}
        <Sprite id="arrow" class="ml-4 h-4 w-4" />
      </small>
    </a>
  </sanserif-next-link>
</footer>
