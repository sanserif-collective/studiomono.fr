# Strapi secrets
API_TOKEN_SALT=
APP_KEYS=
JWT_SECRET=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=

# Server
BASE_URL=http://localhost:1337
STRAPI_TELEMETRY_DISABLED=true
STRAPI_HIDE_STARTUP_MESSAGE=false
ALLOWED_ORIGINS=http://localhost:4321

# S3 / MinIO (local defaults; override in production)
S3_ACCESS_KEY_ID=root
S3_ACCESS_SECRET=rootroot
S3_BUCKET_NAME=strapi-media
S3_ENDPOINT=http://127.0.0.1:9000
S3_BASE_URL=http://localhost:9000/strapi-media
MEDIA_DOMAIN=localhost:9000

# Email
# Local development sends through Mailpit over SMTP. Production sends through
# the Cloudflare Email Service REST API instead.
# EMAIL_PROVIDER=nodemailer
MAILER_EMAIL=Sanserif <sanserif@localhost>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
